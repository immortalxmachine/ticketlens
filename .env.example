# Copy to .env and adjust. Nothing here is secret by default.
# Where the Ollama server listens (Docker: http://host.docker.internal:11434)
OLLAMA_HOST=http://localhost:11434
# Ollama model tag used for the Llama summarizer
OLLAMA_MODEL=llama3.2:3b
# Classifier to serve: distilbert | tfidf
CLASSIFIER=distilbert
# Folder that holds trained models (see models/)
MODELS_DIR=models
# Gradio app talks to the API at this URL
API_URL=http://localhost:8020
